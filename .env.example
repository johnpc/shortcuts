# AWS S3 Configuration
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-west-2
S3_KEY_PREFIX=public/public
FILE_HOST_URL=https://your-file-host.com

# Home Assistant API
HOME_ASSISTANT_API_URL=https://your-home-assistant.com/api/scripts
LIGHTS_API_URL=https://your-home-assistant.com/api/lights
TESLA_API_URL=https://homie.jpc.io/api/car

# Optional: iMessage Notifications
IMESSAGE_PHONE=+1234567890
# Optional: send via BlueBubbles server instead of AppleScript (needed when deploying over SSH)
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=change-me
